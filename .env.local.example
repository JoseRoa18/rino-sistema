# Copia este archivo a .env.local y completa los valores reales

# Supabase (obtenidos en Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...

# Service role: SOLO en servidor (cron jobs). Nunca expongas en cliente.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...

# Token para proteger el endpoint de cron (cualquier string aleatorio largo)
CRON_SECRET=cambia-esto-por-un-token-aleatorio-seguro

# APIs externas (no requieren API key en plan gratuito)
YADIO_API_URL=https://api.yadio.io/exrates/USD
EXCHANGERATE_API_URL=https://open.er-api.com/v6/latest/USD
